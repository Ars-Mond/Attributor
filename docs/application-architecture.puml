@startuml application-architecture
title Attributor — Application Architecture\nTauri 2 + SvelteKit desktop app for stock-photo metadata (XMP/EXIF/IPTC)

' ── Global look & feel ───────────────────────────────────────────────
skinparam linetype ortho
skinparam nodesep 50
skinparam ranksep 65
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam ArrowColor #3A3A3A
skinparam ArrowThickness 1.2
skinparam rectangle {
  BorderColor #3A3A3A
  FontColor #1A1A1A
  roundCorner 12
}
skinparam database {
  BorderColor #3A3A3A
  FontColor #1A1A1A
}
skinparam queue {
  BorderColor #3A3A3A
  FontColor #1A1A1A
}
skinparam cloud {
  BorderColor #3A3A3A
  FontColor #1A1A1A
}
skinparam package {
  BorderColor #9E9E9E
  FontColor #555555
}

' Layer colours:
'  UI shell #B3E5FC · Panels #BBDEFB · State #D1C4E9 · IPC #FFE0B2
'  Backend #C8E6C9 · Metadata engine #A5D6A7 · Storage #E1BEE7 · Disk #FFF9C4
'  AI services #CFD8DC

' ── Frontend ─────────────────────────────────────────────────────────
package "Frontend — SvelteKit 2 / Svelte 5 runes / SCSS tokens" {
  rectangle "+page.svelte\nroot orchestrator\n(wires panels, events, shortcuts)" as PAGE #B3E5FC

  package "UI shell (Eagle-inspired)" {
    rectangle "DockLayout\n(docking/)" as DOCK #B3E5FC
    rectangle "MenuBar\n(menu/)" as MENU #B3E5FC
    rectangle "dialogs\nConfirm/About/Help/Unsaved" as DLG #B3E5FC
    rectangle "reusable\nFileTree/KeywordSuggestions" as REUSE #B3E5FC
  }

  package "Panels" {
    rectangle "FilesPanel\ngallery + folder-changed rescan" as FP #BBDEFB
    rectangle "MetadataPanel\nedit form + autosave\nAttribute via <provider> button" as MP #BBDEFB
    rectangle "ImageViewerPanel\npreview + gone-toast" as IV #BBDEFB
  }

  package "Frontend state (runes)" {
    rectangle "folderLoader +\nmetadataStore (gallery/)" as GAL #D1C4E9
    rectangle "settings · shortcuts\nstore.ts · themes.ts" as CFG #D1C4E9
  }

  package "AI attribution (lib/ai/ · settings/)" {
    rectangle "Settings → AI attribution\n(AiSettingsPage)\nprovider · base URL · API key\nChatGPT sign-in · active model" as AISET #B3E5FC
    rectangle "Settings → Model profiles\n(ModelProfilesPage +\nModelProfileDialog)\nper provider + Base (all providers)" as AIPROF #B3E5FC
    rectangle "ai availability store\n(availability.svelte.ts)\nstatus · models · key\nChatGPT account" as AIAV #D1C4E9
    rectangle "ai.ts\ninvoke wrappers\nprofile lookup →\nAttributionConfig" as AIAPI #D1C4E9
  }

  package "MCP (lib/mcp/ · settings/)" {
    rectangle "Settings → MCP\n(McpSettingsPage)\nserver · port · token\nAI-settings permission\nclient install · recent calls" as MCPSET #B3E5FC
    rectangle "MCP window bridge\n(mcp/bridge.ts)\nstatus · folder · selection\nsettings · AI config\nkeep / refresh editor edits" as MCPBR #D1C4E9
  }
}

' ── Tauri IPC surface ────────────────────────────────────────────────
package "Tauri IPC — typed commands + events (Principle VI)" {
  rectangle "read_folder" as C_RF #FFE0B2
  rectangle "save_metadata_cached(_batch)\nget_cached_metadata" as C_SAVE #FFE0B2
  rectangle "read_metadata" as C_RM #FFE0B2
  rectangle "open_folder / open_folder_path\nscan_folder" as C_FOLDER #FFE0B2
  rectangle "search_keywords" as C_KW #FFE0B2
  queue "events:\nmetadata-status · thumbnail-ready · folder-changed" as EV #FFE0B2

  package "AI commands (ai::)" {
    rectangle "ai_status · ai_list_models\nai_set_api_key · ai_has_api_key\nchatgpt_login · chatgpt_logout\nchatgpt_account\nollama_pull_model · install_ollama" as C_AI #FFE0B2
    rectangle "attribute_photo\nattribute_batch\nai_cancel" as C_ATTR #FFE0B2
    queue "channels:\npull progress\nbatch progress" as AI_CH #FFE0B2
  }

  package "MCP commands (mcp::)" {
    rectangle "mcp_get_config · mcp_set_config\nmcp_regenerate_token · mcp_activity\nmcp_clients · mcp_install_client\nmcp_uninstall_client · mcp_client_snippet" as C_MCP #FFE0B2
    queue "event: mcp-request\nreply: mcp_ui_reply\nready: mcp_ui_ready" as MCP_EV #FFE0B2
  }
}

' ── Backend ──────────────────────────────────────────────────────────
package "Backend — Rust (Pure-Rust, no native deps)" {
  rectangle "lib.rs\nentry · AppState · command handlers" as LIB #C8E6C9
  rectangle "filetree\nscan_dir + notify watcher" as FT #C8E6C9
  rectangle "folder_processor\nrayon fan-out · workers" as FPR #C8E6C9
  rectangle "photo_processor\nclassify (cache) + thumbnails" as PP #C8E6C9
  rectangle "hash\nstat (Stage-1) · SHA-256 (Stage-2)" as HASH #C8E6C9
  rectangle "events\nAppEvent emit helper" as EVT #C8E6C9
  rectangle "keywords\nnucleo fuzzy search" as KW #C8E6C9
  rectangle "conflicts\nPendingConflict registry" as CONF #C8E6C9
}

package "Metadata engine" {
  rectangle "metadata\nread/write XMP·EXIF·IPTC\nquick-xml + little_exif (fork)" as MD #A5D6A7
}

package "AI attribution — ai/ (vision auto-attribution)" {
  rectangle "ai (mod.rs)\ncommand handlers\nAiState: cancel flag\n+ ChatGPT session" as AI_MOD #C8E6C9
  rectangle "attribute\nsingle → result for the form\nbatch → metadata store\n(sequential)\nschema adapt · JSON parse" as AI_ATTR #C8E6C9
  rectangle "image\nOllama: original file\nothers: JPEG ≤ 1568 px" as AI_IMG #C8E6C9
  rectangle "secrets\nAPI keys\nAES-256-GCM sealing" as AI_SEC #C8E6C9

  package "provider clients" as AI_PROV {
    rectangle "ollama\nnative /api/generate · pull\nollama serve auto-start" as AI_OLL #C8E6C9
    rectangle "openai_compat + lmstudio\nChat Completions /v1\nllama.cpp · LM Studio\nJan · vLLM · Unsloth\nlms CLI auto-start" as AI_COMPAT #C8E6C9
    rectangle "openai\nResponses API\nAPI key" as AI_OAI #C8E6C9
    rectangle "chatgpt\nSign in with ChatGPT\nOAuth PKCE (loopback)\nResponses API · plan" as AI_GPT #C8E6C9
    rectangle "anthropic\nClaude Messages API\nAPI key" as AI_ANT #C8E6C9
  }
}

package "MCP server — mcp/ (AI assistants)" {
  rectangle "http\nloopback Streamable HTTP\n127.0.0.1:47821/mcp\nHost · Origin · bearer token" as MCP_HTTP #C8E6C9
  rectangle "protocol + catalog\n2026-07-28 stateless\n+ legacy initialize\n16 tools" as MCP_PROTO #C8E6C9
  rectangle "tools · jobs\nsame paths as the UI commands\n(Save button: save_metadata_impl)\njob ids for long work" as MCP_TOOLS #C8E6C9
  rectangle "bridge\nattributor --mcp (stdio)\nfor Claude Desktop" as MCP_BRIDGE #C8E6C9
  rectangle "install\nclient config merge\n+ .attributor-backup" as MCP_INST #C8E6C9
}

' ── Storage + disk ───────────────────────────────────────────────────
database "CacheStore\nSQLite (bundled, WAL)\nphoto_cache + schema_meta" as DB #E1BEE7
database "tauri-plugin-store\nui-state.json (window, dock, theme)" as PSTORE #E1BEE7
rectangle "Photo files\nJPEG / PNG / WebP" as DISK #FFF9C4
rectangle "Thumbnail sidecars\n{key}.paths / {key}_360.jpg" as THUMB #FFF9C4
database "OS credential store\nCredential Manager ·\nKeychain · Secret Service" as KEYRING #E1BEE7
rectangle "Sealed ChatGPT tokens\nsecrets/chatgpt.bin" as VAULT #FFF9C4
database "mcp.json\nenabled · port · token\nallowAiSettings" as MCPCFG #E1BEE7
rectangle "Client configs\nclaude_desktop_config.json\n~/.claude.json · ~/.codex/config.toml" as CCFG #FFF9C4

' ── AI services ──────────────────────────────────────────────────────
rectangle "Local LLM servers\nOllama :11434 · llama.cpp\nLM Studio · Jan · vLLM\nUnsloth" as LLM_LOCAL #CFD8DC
cloud "Cloud AI APIs\nOpenAI API · Claude API\nChatGPT plan (auth.openai.com)\nOllama Cloud (:cloud models)" as LLM_CLOUD #CFD8DC
rectangle "AI assistants\nClaude Desktop · Claude Code\nChatGPT / Codex" as ASSIST #CFD8DC

' ── Frontend wiring ──────────────────────────────────────────────────
PAGE --> DOCK
PAGE --> MENU
PAGE --> DLG
PAGE --> FP
PAGE --> MP
PAGE --> IV
PAGE --> GAL
PAGE --> CFG
FP --> REUSE
MP --> REUSE
PAGE --> AIAV : init (prefetch)
MP -[norank]-> AIAV : available?
MP --> AIAPI
AISET --> AIAV
AISET --> AIAPI : key · sign-in · pull · install
AISET -[norank]-> CFG : provider · URL · model
AIPROF --> AIAV
AIPROF -[norank]-> CFG : ai.modelProfiles
AIAV -[norank]-> AIAPI
AIAPI -[norank]-> CFG : read config

' ── Frontend → IPC ───────────────────────────────────────────────────
GAL --> C_RF
MP --> C_SAVE
MP --> C_RM
MP --> C_KW
FP --> C_FOLDER
CFG ..> PSTORE : persist UI state
EV --> GAL : metadata-status
EV --> FP : thumbnail-ready / folder-changed
EV --> IV : folder-changed (gone)
AIAPI --> C_AI
AIAPI --> C_ATTR
AI_CH -[norank]-> AIAPI : progress callbacks

' ── IPC → Backend ────────────────────────────────────────────────────
C_RF --> LIB
C_SAVE --> LIB
C_RM --> LIB
C_FOLDER --> LIB
C_KW --> LIB
LIB --> FPR
LIB --> FT
LIB --> DB
FT --> EVT : folder-changed
FPR --> PP
PP --> HASH
PP --> MD
PP --> DB
PP --> EVT : metadata-status
PP --> THUMB : thumbnail cache
FPR --> EVT : thumbnail-ready
LIB --> KW
LIB --> CONF
EVT --> EV

' ── IPC → AI backend ─────────────────────────────────────────────────
C_AI --> AI_MOD
C_ATTR --> AI_MOD
LIB --> AI_MOD : manage AiState
AI_MOD --> AI_ATTR
AI_MOD --> AI_PROV : status · models · sign-in · pull
AI_MOD --> AI_SEC : API keys
AI_MOD --> AI_CH : progress
AI_ATTR --> AI_IMG
AI_ATTR --> AI_PROV : inference
AI_ATTR --> DB : batch result (app-only)
AI_GPT --> AI_SEC : tokens

' ── AI backend → AI services ─────────────────────────────────────────
' Layout only: local-server clients above cloud clients.
AI_OLL -[hidden]down-> AI_OAI
AI_COMPAT -[hidden]down-> AI_GPT
AI_COMPAT -[hidden]down-> AI_ANT
AI_OLL --> LLM_LOCAL : HTTP localhost
AI_COMPAT --> LLM_LOCAL : HTTP /v1
AI_OAI --> LLM_CLOUD : HTTPS + API key
AI_ANT --> LLM_CLOUD : HTTPS + API key
AI_GPT --> LLM_CLOUD : OAuth + plan token
LLM_LOCAL --> LLM_CLOUD : Ollama :cloud models

' ── MCP ──────────────────────────────────────────────────────────────
PAGE --> MCPBR : start after the window shows
MCPSET --> C_MCP
C_MCP --> MCP_HTTP : start · stop · settings
C_MCP --> MCP_INST : install · remove
LIB --> MCP_HTTP : manage McpState
ASSIST --> MCP_HTTP : HTTP + token\n(Claude Code, Codex)
ASSIST --> MCP_BRIDGE : stdio\n(Claude Desktop)
MCP_BRIDGE --> MCP_HTTP : forward tools/call
MCP_HTTP --> MCP_PROTO
MCP_PROTO --> MCP_TOOLS
MCP_TOOLS --> MCP_EV : ask the window
MCP_EV --> MCPBR
MCPBR -[norank]-> MP : keep edits · refresh
MCPBR -[norank]-> CFG : settings (AI only if allowed)
MCP_TOOLS --> DB : metadata (app-only / synced)
MCP_TOOLS --> MD : save like the Save button
MCP_TOOLS --> AI_ATTR : attribution (own cancel flag)
MCP_HTTP ..> MCPCFG : token
MCP_BRIDGE ..> MCPCFG : port · token
MCP_INST ..> CCFG : merge entries

' ── Backend → disk ───────────────────────────────────────────────────
HASH ..> DISK : stat / hash
MD ..> DISK : read (write = export only)
FT ..> DISK : scan + watch
AI_IMG ..> DISK : read photo
AI_SEC ..> KEYRING : keys + sealing key
AI_SEC ..> VAULT : sealed tokens

legend right
  | Colour | Layer |
  |<#B3E5FC>   | UI shell + root |
  |<#BBDEFB>   | Panels |
  |<#D1C4E9>   | Frontend state |
  |<#FFE0B2>   | Tauri IPC |
  |<#C8E6C9>   | Backend Rust |
  |<#A5D6A7>   | Metadata engine |
  |<#E1BEE7>   | Persistent stores |
  |<#FFF9C4>   | Filesystem |
  |<#CFD8DC>   | AI services (local / cloud) |
  ----
  Solid = call / data flow
  Dotted = filesystem / persistence I/O
endlegend

@enduml
